# Скопируйте в .env. Значения остаются только на вашем Mac.
BOT_TOKEN=
BOT_USERNAME=izbrainoe_bot
# HTTPS-адрес нужен только для открытия подборок с телефона.
PUBLIC_URL=
ENABLE_TUNNEL=1
PORT=8765
# Локальная модель, без облака и платных API. Пустое значение отключает.
OLLAMA_URL=http://127.0.0.1:11435
EMBED_MODEL=qwen3-embedding:0.6b
CHAT_MODEL=qwen3:4b
# Дополнительные Telegram ID через запятую. Владелец подключается кодом из локального интерфейса.
ALLOWED_USER_IDS=

# Читаем только первые 2–4 страницы PDF.
PDF_PREVIEW_PAGES=4
# Только общие неперсональные запросы о типе материала; 0 — полностью отключить.
WEB_LOOKUP=1
WEB_BACKEND=bing
# Прямая загрузка оригиналов через Mini App, МБ.
MAX_UPLOAD_MB=100

# Gemini подключается в локальных Настройках; ключ хранится в data/ai-settings.json.
# Не вставляйте API-ключ в этот пример или исходный код.
